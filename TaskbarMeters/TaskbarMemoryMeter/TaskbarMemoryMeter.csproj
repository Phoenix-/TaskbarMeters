<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>TaskbarMemoryMeter</RootNamespace>
    <AssemblyName>TaskbarMemoryMeter</AssemblyName>
    <ApplicationIcon>Images\RAM.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskbarCore\TaskbarCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\RAM.ico" />
  </ItemGroup>

</Project>
